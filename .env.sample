# Environment selector — controls which .env.<name> file is loaded.
# Valid values: local | dev | qa | staging
PROOFHUB_ENV=

# Full login URL of the ProofHub instance under test.
PROOFHUB_BASE_URL=

# Credentials for the dedicated test account. Never use a real engineer's personal account.
PROOFHUB_TEST_EMAIL=
PROOFHUB_TEST_PASSWORD=

# Page navigation timeout in milliseconds (default: 30000).
PROOFHUB_NAVIGATION_TIMEOUT_MS=
